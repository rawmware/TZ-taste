{
 "_tzmeta": {
  "id": "vscode-acid-rave",
  "title": "Acid Rave VS Code theme",
  "category": "VS Code",
  "file": "vscode/acid-rave.json",
  "tags": [
   "vscode",
   "theme",
   "acid-rave"
  ],
  "description": "VS Code color theme from the Acid Rave DNA tokens.",
  "dnas": [
   "acid-rave"
  ]
 },
 "name": "TZ Acid Rave",
 "type": "dark",
 "colors": {
  "editor.background": "#0a0a0a",
  "editor.foreground": "#f2f2f2",
  "editorLineNumber.foreground": "#7a7a7a",
  "editorCursor.foreground": "#c6ff00",
  "activityBar.background": "#131313",
  "activityBar.foreground": "#f2f2f2",
  "sideBar.background": "#131313",
  "statusBar.background": "#c6ff00",
  "statusBar.foreground": "#0a0a0a",
  "tab.activeBackground": "#0a0a0a",
  "tab.inactiveBackground": "#131313",
  "editorGroupHeader.tabsBackground": "#131313",
  "terminal.background": "#0a0a0a",
  "terminal.foreground": "#f2f2f2",
  "panel.background": "#131313",
  "editorWidget.background": "#131313",
  "pickerGroup.foreground": "#c6ff00",
  "progressBar.background": "#c6ff00",
  "focusBorder": "#f2f2f21f"
 },
 "tokenColors": [
  {
   "scope": [
    "comment"
   ],
   "settings": {
    "foreground": "#7a7a7a",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage"
   ],
   "settings": {
    "foreground": "#c6ff00"
   }
  },
  {
   "scope": [
    "string"
   ],
   "settings": {
    "foreground": "#f2f2f2"
   }
  },
  {
   "scope": [
    "variable",
    "identifier"
   ],
   "settings": {
    "foreground": "#f2f2f2"
   }
  },
  {
   "scope": [
    "entity.name.function"
   ],
   "settings": {
    "foreground": "#c6ff00",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "support.type"
   ],
   "settings": {
    "foreground": "#7a7a7a"
   }
  }
 ]
}
