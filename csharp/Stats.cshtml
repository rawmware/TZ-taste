@*tz-meta {"id":"cs-stats","title":"Terminal status readout (Razor)","category":"C#","file":"csharp/Stats.cshtml","tags":["csharp","razor","stats"],"description":"Stats for Hedgehog Host, a small hosting company — delivered as a phosphor-green terminal status readout: sparklines, amber warnings, a blinking block cursor, and a fake tail -f deploy log.","dnas":["retro-terminal"]} *@
@page
@{
    ViewData["Title"] = "Hedgehog Host — system status";
    var bg = "#0b0f0a";
    var ink = "#33ff66";
    var accent = "#ffb000";
    var muted = "#1f6b3a";
    var line = "#33ff6633";
    var surface = "#0e140d";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
  :root{
    --bg:@bg; --ink:@ink; --accent:@accent; --muted:@muted; --line:@line; --surface:@surface;
    --ease:cubic-bezier(.22,1,.36,1);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:var(--bg);color:var(--ink);
    font-family:'IBM Plex Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:15px;line-height:1.65}
  /* Scanlines: the phosphor texture, done with a repeating gradient of the line token */
  body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:5;
    background:repeating-linear-gradient(0deg,transparent 0 2px,#0b0f0a88 2px 3px)}
  .tz-term{max-width:980px;margin:0 auto;
    padding:clamp(48px,7vw,110px) clamp(20px,5vw,56px) clamp(64px,8vw,110px)}
  .tz-bar{display:flex;gap:8px;margin-bottom:clamp(36px,5vw,64px)}
  .tz-bar i{width:12px;height:12px;border-radius:50%;background:var(--muted)}
  .tz-bar i:first-child{background:var(--accent)}
  .tz-prompt{color:var(--accent);margin-bottom:6px}
  .tz-prompt .cmd{color:var(--ink)}
  .tz-sub{color:var(--muted);margin-bottom:clamp(36px,5vw,60px)}
  .tz-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;
    background:var(--line);border:1px solid var(--line);margin-bottom:clamp(36px,5vw,60px)}
  .tz-cell{background:var(--surface);padding:26px clamp(18px,3vw,30px)}
  .tz-label{font-size:11px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--muted);margin-bottom:12px}
  .tz-value{font-size:clamp(34px,4.6vw,52px);font-weight:600;letter-spacing:-.02em;
    line-height:1;margin-bottom:10px}
  .tz-value.warn{color:var(--accent)}
  /* The distinctive choice: mono sparkline rows, one per stat */
  .tz-spark{font-size:15px;letter-spacing:2px;color:var(--muted);white-space:nowrap;
    overflow:hidden}
  .tz-spark b{color:var(--ink);font-weight:400}
  .tz-note{font-size:12.5px;color:var(--muted)}
  .tz-note .ok{color:var(--ink)}
  .tz-log{border:1px solid var(--line);background:var(--surface);
    padding:24px clamp(18px,3vw,30px);margin-bottom:clamp(36px,5vw,60px)}
  .tz-log h2{font-size:11px;letter-spacing:.2em;text-transform:uppercase;
    color:var(--muted);margin-bottom:16px;font-weight:400}
  .tz-log p{font-size:13.5px;margin-bottom:6px;opacity:0;
    animation:tz-in .5s var(--ease) forwards}
  .tz-log p:nth-child(2){animation-delay:.3s}
  .tz-log p:nth-child(3){animation-delay:.7s}
  .tz-log p:nth-child(4){animation-delay:1.1s}
  .tz-log p:nth-child(5){animation-delay:1.5s}
  .tz-log .t{color:var(--muted)}
  .tz-log .w{color:var(--accent)}
  @@keyframes tz-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .tz-cursor{display:inline-block;width:.62em;height:1.15em;background:var(--ink);
    vertical-align:-0.2em;animation:tz-blink 1.1s steps(1) infinite}
  @@keyframes tz-blink{50%{opacity:0}}
  .tz-cta{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
  .tz-btn{color:var(--bg);background:var(--ink);text-decoration:none;
    font-size:13px;letter-spacing:.12em;text-transform:uppercase;
    padding:15px 28px;font-weight:600;transition:background .25s var(--ease)}
  .tz-btn:hover{background:var(--accent)}
  .tz-fine{font-size:12.5px;color:var(--muted)}
  @@media (max-width:640px){
    .tz-grid{grid-template-columns:1fr}
    .tz-value{font-size:38px}
  }
  @@media (prefers-reduced-motion:reduce){
    .tz-log p{opacity:1;animation:none}
    .tz-cursor{animation:none}
  }
</style>
</head>
<body>
  <div class="tz-term">
    <div class="tz-bar" aria-hidden="true"><i></i><i></i><i></i></div>

    <p class="tz-prompt">hedgehog@@status <span class="cmd">--quarter q3</span></p>
    <p class="tz-sub"># boring, in the way you want from infrastructure.</p>

    <div class="tz-grid">
      <div class="tz-cell">
        <p class="tz-label">Uptime · 90 days</p>
        <p class="tz-value">99.98%</p>
        <p class="tz-spark" aria-hidden="true">▁▁▁▁▁▁▁▁<b>▁</b>▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁</p>
        <p class="tz-note"><span class="ok">11 min</span> of downtime, one Tuesday, our fault</p>
      </div>
      <div class="tz-cell">
        <p class="tz-label">Median response</p>
        <p class="tz-value">41ms</p>
        <p class="tz-spark" aria-hidden="true">▃▂▃▂▁<b>▁</b>▂▁▁▂▁▁▁▂▁▁▁▁▁▁▁▁▁▁▁▁▁</p>
        <p class="tz-note">measured at the edge, not in our office</p>
      </div>
      <div class="tz-cell">
        <p class="tz-label">Deploys shipped</p>
        <p class="tz-value">1,204</p>
        <p class="tz-spark" aria-hidden="true">▂▃▂▄▃▅▄<b>▆</b>▅▅▇▆▅▇▆▅▅▆▅▅▆▅▅▆▅▆</p>
        <p class="tz-note">zero-downtime, every single one</p>
      </div>
      <div class="tz-cell">
        <p class="tz-label">Support · first reply</p>
        <p class="tz-value warn">11 min</p>
        <p class="tz-spark" aria-hidden="true">▅▄▅▃▄▃▂<b>▂</b>▃▂▂▂▁▂▁▁▁▁▁▁▁▁▁▁▁</p>
        <p class="tz-note">a human, not a bot — <span class="ok">312 tickets</span> this quarter</p>
      </div>
    </div>

    <div class="tz-log" aria-label="Recent deploy log">
      <h2>$ tail -f /var/log/deploys</h2>
      <p><span class="t">14:02:11</span> deploy ok — api v2.14.3 <span class="t">(38s, no downtime)</span></p>
      <p><span class="t">13:47:02</span> deploy ok — billing v1.9.0 <span class="t">(51s)</span></p>
      <p><span class="t">11:20:44</span> <span class="w">warn</span> — node fra-02 warm restart <span class="t">(traffic shifted, nobody noticed)</span></p>
      <p><span class="t">09:15:30</span> deploy ok — static v4.2.1 <span class="t">(22s)</span></p>
    </div>

    <div class="tz-cta">
      <a class="tz-btn" href="#migrate">Move your site over</a>
      <p class="tz-fine">$12/mo · we migrate you free · <span class="tz-cursor" aria-hidden="true"></span></p>
    </div>
  </div>
</body>
</html>
