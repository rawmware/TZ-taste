@*tz-meta {"id":"cs-features","title":"Features as spec table (Razor)","category":"C#","file":"csharp/Features.cshtml","tags":["csharp","razor","features"],"description":"Features for Karton, an inventory app for small makers — rendered as a numbered Swiss spec table with red index numerals and measured mono specs. No cards at all.","dnas":["swiss-rational"]} *@
@page
@{
    ViewData["Title"] = "Karton — inventory for small makers";
    var bg = "#fafafa";
    var ink = "#111111";
    var accent = "#e30613";
    var muted = "#6b6b6b";
    var line = "#111111";
    var surface = "#f0f0f0";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
  :root{
    --bg:@bg; --ink:@ink; --accent:@accent; --muted:@muted; --line:@line; --surface:@surface;
    --ease:cubic-bezier(.22,1,.36,1);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{background:var(--bg);color:var(--ink);
    font-family:'Archivo',Helvetica,Arial,sans-serif;line-height:1.5}
  .tz-wrap{max-width:1180px;margin:0 auto;
    padding:clamp(64px,9vw,140px) clamp(20px,5vw,72px) clamp(64px,8vw,120px)}
  .tz-eyebrow{font-family:'Space Mono',ui-monospace,monospace;font-size:11px;
    letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:26px}
  h1{font-family:'Archivo',Helvetica,Arial,sans-serif;font-weight:800;
    letter-spacing:-.035em;font-size:clamp(40px,6.4vw,92px);line-height:1.0;
    max-width:13ch;margin-bottom:20px}
  h1 .red{color:var(--accent)}
  .tz-dek{font-size:clamp(16px,1.8vw,20px);color:var(--muted);max-width:52ch;
    margin-bottom:clamp(48px,6vw,88px)}
  /* The distinctive choice: features as a measured spec table, index in red */
  .tz-spec{border-top:2px solid var(--line)}
  .tz-row{display:grid;grid-template-columns:88px minmax(0,3fr) minmax(0,5fr) auto;
    gap:clamp(16px,3vw,44px);align-items:baseline;
    padding:30px 0;border-bottom:1px solid var(--line);
    transition:background .25s var(--ease)}
  .tz-row:hover{background:var(--surface)}
  .tz-idx{font-family:'Archivo',Helvetica,Arial,sans-serif;font-weight:800;
    font-size:clamp(26px,3vw,40px);color:var(--accent);letter-spacing:-.02em}
  .tz-name{font-weight:700;font-size:clamp(18px,2vw,24px);letter-spacing:-.01em}
  .tz-desc{color:var(--muted);font-size:15.5px;max-width:52ch}
  .tz-specval{font-family:'Space Mono',ui-monospace,monospace;font-size:12px;
    letter-spacing:.06em;color:var(--ink);white-space:nowrap;
    border:1px solid var(--line);padding:7px 12px}
  .tz-foot{margin-top:clamp(44px,5vw,72px);display:flex;align-items:center;
    justify-content:space-between;gap:24px;flex-wrap:wrap}
  .tz-note{font-family:'Space Mono',ui-monospace,monospace;font-size:12px;
    letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .tz-btn{display:inline-block;background:var(--accent);color:var(--bg);
    font-weight:700;font-size:15px;letter-spacing:.02em;text-decoration:none;
    padding:16px 30px;transition:transform .25s var(--ease),background .25s var(--ease)}
  .tz-btn:hover{transform:translateY(-2px);background:var(--ink)}
  .tz-rise{opacity:0;transform:translateY(22px);animation:tz-rise .8s var(--ease) forwards}
  .tz-rise.d1{animation-delay:.1s}.tz-rise.d2{animation-delay:.2s}
  @@keyframes tz-rise{to{opacity:1;transform:none}}
  @@media (max-width:760px){
    .tz-row{grid-template-columns:52px 1fr;grid-template-areas:
      "idx name" "idx desc" "idx spec";row-gap:8px}
    .tz-idx{grid-area:idx;font-size:26px}
    .tz-name{grid-area:name}.tz-desc{grid-area:desc}.tz-specval{grid-area:spec;justify-self:start}
  }
  @@media (prefers-reduced-motion:reduce){
    .tz-rise{opacity:1;transform:none;animation:none}
    *{transition:none !important}
  }
</style>
</head>
<body>
  <div class="tz-wrap">
    <p class="tz-eyebrow tz-rise">Karton · What it does</p>
    <h1 class="tz-rise d1">Know what's on the shelf, <span class="red">every Tuesday.</span></h1>
    <p class="tz-dek tz-rise d2">Karton is inventory for people who make things in small batches —
    potters, roasters, soap cutters, print shops. Five jobs, done properly. Nothing else.</p>

    <div class="tz-spec tz-rise d2">
      <div class="tz-row">
        <div class="tz-idx">01</div>
        <div class="tz-name">Scan it in</div>
        <p class="tz-desc">Point the phone at a barcode and the stock count moves. Works with the
        scanner you already own, or the camera in your pocket.</p>
        <span class="tz-specval">≤ 2 s / scan</span>
      </div>
      <div class="tz-row">
        <div class="tz-idx">02</div>
        <div class="tz-name">Low-stock flags</div>
        <p class="tz-desc">Set a floor per material. Karton taps you on the shoulder before you run
        out of the clay you actually sell with — not after.</p>
        <span class="tz-specval">alerts at your floor</span>
      </div>
      <div class="tz-row">
        <div class="tz-idx">03</div>
        <div class="tz-name">Supplier ledger</div>
        <p class="tz-desc">Every bag of beans, every box of jars, tied to who sold it to you and
        what you paid. Reorder day stops being detective work.</p>
        <span class="tz-specval">cost / unit tracked</span>
      </div>
      <div class="tz-row">
        <div class="tz-idx">04</div>
        <div class="tz-name">Pick lists</div>
        <p class="tz-desc">Market Saturday? Karton builds the load-out list from your open orders,
        shelf by shelf, so nothing gets left in the studio.</p>
        <span class="tz-specval">shelf-ordered</span>
      </div>
      <div class="tz-row">
        <div class="tz-idx">05</div>
        <div class="tz-name">Works offline</div>
        <p class="tz-desc">Basements, barns, fairgrounds with one bar of signal. Counts sync when
        you're back in range. Nothing lost, ever.</p>
        <span class="tz-specval">0 bars required</span>
      </div>
    </div>

    <div class="tz-foot">
      <p class="tz-note">Free for your first 50 SKUs · no card</p>
      <a class="tz-btn" href="#start">Start your free count</a>
    </div>
  </div>
</body>
</html>
